# نسخة من هذا الملف: .env — ثم عبّي القيم

# قاعدة البيانات (من Neon بعد إنشاء المشروع):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/zaboon?sslmode=require
# على Vercel فعّل: PGSSL=true  (قاعدة Neon تتطلب تشفير)

# سرّ التوكن — غيّره لشيء طويل عشوائي:
# JWT_SECRET=اكتب-هنا-سر-طويل-جدا

# وضع التطوير: يظهر رمز الـ OTP في رد الـ API (بدون SMS مزود بعد)
# DEV_OTP=true

# على Vercel هذه المتغيرات تضاف من: Project Settings → Environment Variables
# DATABASE_URL, PGSSL=true, JWT_SECRET, DEV_OTP=true
# بوت تليجرام (اختياري — يفعل توصيل OTP مجاني)
TELEGRAM_BOT_TOKEN=
# WEBHOOK_URL=https://soog-delta.vercel.app  # يدعم الـ webhook خارج Vercel
